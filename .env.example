# Copy to .env and edit. Nothing here may be a working secret — .env is
# gitignored specifically so real values never end up in the repository.

# --- Mongo ---------------------------------------------------------------
# Database name only; docker-compose.yml wires the rest. Leave MONGO_USER
# blank for the no-auth local Mongo the compose file starts.
MONGO_DB=portfolio_shop
MONGO_USER=
MONGO_PASSWORD=

# --- Keycloak --------------------------------------------------------------
# This project does not run its own Keycloak — point it at the one the
# sibling `fanvote` checkout already runs locally, or any other instance with
# a "shop" realm (client "frontend", realm role "shop-admin" for the admin
# area). From inside a container on Docker Desktop, the host is reachable at
# host.docker.internal.
KEYCLOAK_ISSUER_URI=http://host.docker.internal:8080/realms/shop

# --- BTCPay Server -----------------------------------------------------------
# Also reused from the fanvote stack, or any self-hosted BTCPay instance.
# Leave every BTCPAY_* value blank to run without payments: the catalogue,
# accounts and orders still work, and POST /api/payments/invoices answers a
# clear 503 instead of crashing the app.
BTCPAY_URL=http://host.docker.internal:49392
# Only needed if BTCPAY_URL is not already what the browser can reach — see
# BtcPayProperties#publicUrl for why the checkout link needs rewriting.
BTCPAY_PUBLIC_URL=http://localhost:49392
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_CURRENCY=USD
BTCPAY_INVOICE_EXPIRATION_MINUTES=60
